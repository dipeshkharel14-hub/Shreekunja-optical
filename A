<script>
// ═══════════════════════════════════════
//  PARTICLES
// ═══════════════════════════════════════
const pWrap = document.getElementById('particles');
for (let i = 0; i < 18; i++) {
  const p = document.createElement('div');
  p.className = 'particle';
  p.style.cssText = `left:${Math.random()*100}%;--dur:${5+Math.random()*8}s;--del:${Math.random()*8}s;`;
  pWrap.appendChild(p);
}

// ═══════════════════════════════════════
//  NAV
// ═══════════════════════════════════════
function setNav(el) {
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  el.classList.add('active');
}

// ═══════════════════════════════════════
//  LENS SIMULATOR
// ═══════════════════════════════════════
const viewer = document.getElementById('simViewer');
const cvA = document.getElementById('cvA');    // premium — right
const cvB = document.getElementById('cvB');    // standard — left (clipped)
const ctxA = cvA.getContext('2d');
const ctxB = cvB.getContext('2d');
const simLine = document.getElementById('simLine');
const simKnob = document.getElementById('simKnob');

let sliderPct = 50;
let dragging = false;
let currentMode = 'bluecut';

function sizeCanvases() {
  const W = viewer.clientWidth, H = viewer.clientHeight;
  [cvA, cvB].forEach(c => { c.width = W; c.height = H; });
  render();
}

// deterministic pseudo-random
function dr(a, b) { return ((Math.sin(a * 127.1 + b * 311.7) * 43758.5453) % 1 + 1) % 1; }

function render() {
  const W = cvA.width, H = cvA.height;
  drawSceneA(ctxA, W, H); // premium
  drawSceneB(ctxB, W, H); // standard
  // clip standard to left side
  cvB.style.clipPath = `inset(0 ${100 - sliderPct}% 0 0)`;
  simLine.style.left = sliderPct + '%';
  simKnob.style.left = sliderPct + '%';
}

/* ---- PREMIUM SCENE ---- */
function drawSceneA(ctx, W, H) {
  ctx.clearRect(0, 0, W, H);
  if (currentMode === 'bluecut' || currentMode === 'progressive') drawOffice(ctx, W, H, true);
  else if (currentMode === 'antiglare') drawNight(ctx, W, H, true);
  else if (currentMode === 'polarized') drawRoad(ctx, W, H, true);
  else drawSun(ctx, W, H, true);
}

/* ---- STANDARD SCENE ---- */
function drawSceneB(ctx, W, H) {
  ctx.clearRect(0, 0, W, H);
  if (currentMode === 'bluecut' || currentMode === 'progressive') drawOffice(ctx, W, H, false);
  else if (currentMode === 'antiglare') drawNight(ctx, W, H, false);
  else if (currentMode === 'polarized') drawRoad(ctx, W, H, false);
  else drawSun(ctx, W, H, false);
}

/* ---- OFFICE SCENE ---- */
function drawOffice(ctx, W, H, prem) {
  // BG
  const bg = ctx.createLinearGradient(0,0,0,H);
  bg.addColorStop(0, prem?'#080e18':'#060c14');
  bg.addColorStop(1, prem?'#0a1420':'#070e18');
  ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);
  // Desk
  ctx.fillStyle=prem?'#111826':'#0d1320';
  ctx.fillRect(0,H*.65,W,H*.35);
  // Monitor
  const mx=W*.2,my=H*.05,mw=W*.6,mh=H*.55;
  ctx.fillStyle='#12182a'; ctx.fillRect(mx,my,mw,mh);
  const sc=ctx.createLinearGradient(mx,my,mx+mw,my+mh);
  sc.addColorStop(0,prem?'#060e28':'#0c1638');
  sc.addColorStop(1,prem?'#080c20':'#0a1230');
  ctx.fillStyle=sc; ctx.fillRect(mx+2,my+2,mw-4,mh-4);
  // Screen text rows
  for(let i=0;i<8;i++){
    const a=prem?0.45+dr(3,i)*.4:0.1+dr(3,i)*.12;
    ctx.fillStyle=`rgba(80,160,255,${a})`;
    ctx.fillRect(mx+10,my+12+i*22,(mw-20)*(0.35+dr(3,i+8)*.5),5);
  }
  // Blue glow
  const gl=ctx.createRadialGradient(mx+mw/2,my+mh/2,0,mx+mw/2,my+mh/2,mw);
  gl.addColorStop(0,prem?'rgba(30,70,200,0.08)':'rgba(40,90,255,0.4)');
  gl.addColorStop(1,'rgba(30,70,200,0)');
  ctx.fillStyle=gl; ctx.fillRect(0,0,W,H);
  if(prem){ ctx.fillStyle='rgba(255,215,140,0.05)'; ctx.fillRect(0,0,W,H); }
  else { ctx.fillStyle='rgba(60,100,255,0.08)'; ctx.fillRect(0,0,W,H); }
  // Keyboard
  ctx.fillStyle=prem?'rgba(70,80,100,0.5)':'rgba(50,60,80,0.35)';
  ctx.fillRect(W*.18,H*.72,W*.64,H*.07);
  for(let i=0;i<48;i++){
    ctx.fillStyle='rgba(200,210,230,0.12)';
    ctx.fillRect(W*.2+i*W*.012,H*.73,W*.009,H*.045);
  }
}

/* ---- NIGHT SCENE ---- */
function drawNight(ctx, W, H, prem) {
  const bg=ctx.createLinearGradient(0,0,0,H);
  bg.addColorStop(0,prem?'#040810':'#06090f');
  bg.addColorStop(1,prem?'#080d18':'#050810');
  ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);
  // Road
  ctx.fillStyle=prem?'#0d1020':'#090c18';
  ctx.fillRect(0,H*.6,W,H*.4);
  ctx.save(); ctx.setLineDash([18,12]);
  ctx.strokeStyle=prem?'rgba(255,255,180,0.5)':'rgba(255,255,180,0.2)';
  ctx.lineWidth=1.5; ctx.beginPath();
  ctx.moveTo(W/2,H*.6); ctx.lineTo(W/2,H); ctx.stroke(); ctx.restore();
  // Buildings
  [[0,.6,.12,.4],[.1,.42,.12,.58],[.2,.52,.1,.48],[.3,.36,.14,.64],[.42,.46,.12,.54],[.53,.4,.11,.6],[.62,.52,.13,.48],[.74,.38,.15,.62],[.88,.58,.13,.42]].forEach(([bx,by,bw,bh],bi)=>{
    ctx.fillStyle=`hsl(220,18%,${prem?10:7}%)`;
    ctx.fillRect(W*bx,H*by,W*bw,H*bh);
    for(let wy=H*(by+.03);wy<H*(by+bh)-5;wy+=10)
      for(let wx=W*bx+4;wx<W*(bx+bw)-4;wx+=9)
        if(dr(bi,wx+wy)>.42){ ctx.fillStyle=`rgba(255,225,90,${prem?0.3+dr(bi,wx)*.5:0.08+dr(bi,wx)*.12})`; ctx.fillRect(wx,wy,4,3); }
  });
  // Neon
  [['HOTEL',.1,.28,'#ff4444'],['BAR',.44,.3,'#44ffaa'],['24/7',.65,.26,'#4499ff']].forEach(([t,sx,sy,col])=>{
    ctx.font=`bold ${W*.038}px sans-serif`;
    ctx.shadowColor=col; ctx.shadowBlur=prem?12:4;
    ctx.fillStyle=prem?col:col+'66'; ctx.fillText(t,W*sx,H*sy); ctx.shadowBlur=0;
  });
  // Headlights
  [[.26,.7],[.32,.7],[.58,.68],[.64,.68]].forEach(([lx,ly])=>{
    const r=prem?W*.07:W*.22;
    const lg=ctx.createRadialGradient(W*lx,H*ly,0,W*lx,H*ly,r);
    lg.addColorStop(0,'rgba(255,255,220,.98)');
    lg.addColorStop(prem?.28:.12,prem?'rgba(255,255,180,.3)':'rgba(255,255,210,.82)');
    lg.addColorStop(1,'rgba(255,255,160,0)');
    ctx.fillStyle=lg; ctx.fillRect(0,0,W,H);
    if(!prem){ // starburst
      ctx.save(); ctx.translate(W*lx,H*ly);
      for(let a=0;a<8;a++){ ctx.rotate(Math.PI/4); const sg=ctx.createLinearGradient(0,0,W*.18,0); sg.addColorStop(0,'rgba(255,255,180,.45)'); sg.addColorStop(1,'rgba(255,255,180,0)'); ctx.fillStyle=sg; ctx.fillRect(0,-2,W*.18,4); }
      ctx.restore();
    }
  });
  if(!prem){ ctx.fillStyle='rgba(160,180,255,.06)'; ctx.fillRect(0,0,W,H); }
}

/* ---- ROAD SCENE ---- */
function drawRoad(ctx, W, H, prem) {
  const sky=ctx.createLinearGradient(0,0,0,H*.55);
  sky.addColorStop(0,prem?'#163060':'#2856a0');
  sky.addColorStop(1,prem?'#2266a8':'#4878c0');
  ctx.fillStyle=sky; ctx.fillRect(0,0,W,H*.55);
  ctx.fillStyle=prem?'#20242e':'#282c3a';
  ctx.fillRect(0,H*.55,W,H*.45);
  ctx.save(); ctx.setLineDash([20,14]); ctx.strokeStyle=prem?'rgba(255,255,180,.5)':'rgba(255,255,180,.22)'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.moveTo(W/2,H*.55); ctx.lineTo(W/2,H); ctx.stroke(); ctx.restore();
  // Mountains
  ctx.fillStyle=prem?'rgba(16,34,70,.85)':'rgba(30,52,90,.65)';
  ctx.beginPath(); ctx.moveTo(0,H*.55);
  [0,.13,.22,.34,.5,.62,.74,.86,1].forEach((x,i)=>ctx.lineTo(W*x,H*(i%2===0?.34:.22)));
  ctx.lineTo(W,H*.55); ctx.closePath(); ctx.fill();
  // Glare
  if(!prem){
    const gl=ctx.createLinearGradient(0,H*.55,0,H);
    gl.addColorStop(0,'rgba(150,185,240,.65)'); gl.addColorStop(.4,'rgba(150,185,240,.35)'); gl.addColorStop(1,'rgba(80,120,180,.08)');
    ctx.fillStyle=gl; ctx.fillRect(0,H*.55,W,H*.45);
    for(let i=0;i<10;i++){ const sg=ctx.createLinearGradient(W*(i/10),H*.56,W*(i/10+.15),H*.74); sg.addColorStop(0,'rgba(200,218,255,.36)'); sg.addColorStop(1,'rgba(200,218,255,0)'); ctx.fillStyle=sg; ctx.fillRect(W*(i/10),H*.55,W*.13,H*.4); }
  } else {
    ctx.fillStyle='rgba(28,60,120,.1)'; ctx.fillRect(0,H*.55,W,H*.45);
  }
}

/* ---- SUN SCENE ---- */
function drawSun(ctx, W, H, prem) {
  const sky=ctx.createLinearGradient(0,0,0,H*.62);
  sky.addColorStop(0,prem?'#154070':'#2c60b0');
  sky.addColorStop(1,prem?'#2a76b8':'#4e8fd4');
  ctx.fillStyle=sky; ctx.fillRect(0,0,W,H*.62);
  ctx.fillStyle=prem?'#2c5020':'#385e28';
  ctx.fillRect(0,H*.62,W,H*.38);
  const sx=W*.72,sy=H*.15;
  const sg=ctx.createRadialGradient(sx,sy,0,sx,sy,prem?W*.1:W*.28);
  sg.addColorStop(0,'rgba(255,252,200,1)'); sg.addColorStop(.3,prem?'rgba(255,220,60,.5)':'rgba(255,255,255,.85)'); sg.addColorStop(1,'rgba(255,200,50,0)');
  ctx.fillStyle=sg; ctx.fillRect(0,0,W,H*.62);
  // Trees
  for(let i=0;i<8;i++){ const tx=W*(.06+i*.12),ty=H*(.5+dr(7,i)*.08); ctx.fillStyle=prem?'rgba(14,28,12,.9)':'rgba(22,42,18,.75)'; ctx.beginPath(); ctx.moveTo(tx,ty); ctx.lineTo(tx-W*.028,H*.62); ctx.lineTo(tx+W*.028,H*.62); ctx.closePath(); ctx.fill(); }
  if(prem){ ctx.fillStyle='rgba(60,40,0,.24)'; ctx.fillRect(0,0,W,H); }
}

// ─── DRAG ───
function getPct(e) {
  const r = viewer.getBoundingClientRect();
  const cx = e.touches ? e.touches[0].clientX : e.clientX;
  return Math.max(4, Math.min(96, (cx - r.left) / r.width * 100));
}
viewer.addEventListener('mousedown',  e=>{ dragging=true; sliderPct=getPct(e); render(); });
window.addEventListener('mousemove',  e=>{ if(dragging){ sliderPct=getPct(e); render(); } });
window.addEventListener('mouseup',    ()=>{ dragging=false; });
viewer.addEventListener('touchstart', e=>{ dragging=true; sliderPct=getPct(e); render(); },{passive:true});
window.addEventListener('touchmove',  e=>{ if(dragging){ sliderPct=getPct(e); render(); } },{passive:true});
window.addEventListener('touchend',   ()=>{ dragging=false; });


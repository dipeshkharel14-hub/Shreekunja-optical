//  ADD PRODUCT MODAL (Admin)
// ═══════════════════════════════════════
let newImgDataUrl = null;

function openAddModal() {
  document.getElementById('addModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeAddModal(e) {
  if (!e || e.target === document.getElementById('addModal')) {
    document.getElementById('addModal').classList.remove('open');
    document.body.style.overflow = '';
  }
}

function previewImg(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    newImgDataUrl = e.target.result;
    const preview = document.getElementById('imgPreview');
    preview.innerHTML = `<img src="${newImgDataUrl}" alt="Preview" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;border-radius:14px;">`;
  };
  reader.readAsDataURL(file);
}

function addNewProduct() {
  const name = document.getElementById('newName').value.trim();
  const price = document.getElementById('newPrice').value.trim();
  const features = document.getElementById('newFeatures').value.trim();

  if (!name || !price) {
    alert('Please enter at least a product name and price.');
    return;
  }

  const grid = document.getElementById('productsGrid');
  const card = document.createElement('div');
  card.className = 'product-card';

  const waMsg = encodeURIComponent(`नमस्ते! ${name} को बारेमा जानकारी चाहन्छु।`);

  card.innerHTML = `
    <div class="product-badge">NEW</div>
    <div class="product-img-wrap">
      ${newImgDataUrl
        ? `<img src="${newImgDataUrl}" alt="${name}">`
        : `<div class="product-img-placeholder"><div class="ph-icon">🕶️</div><div class="ph-label">No Image</div></div>`
      }
    </div>
    <div class="product-info">
      <div class="product-name">${name}</div>
      ${features ? `<div class="product-function">${features}</div>` : ''}
      <div class="product-price">Rs ${price} <span>/ pair</span></div>
      <a class="product-wa-link" href="https://wa.me/9841623999?text=${waMsg}" target="_blank">
        📲 WhatsApp गर्नुहोस्
      </a>
    </div>
  `;

  grid.appendChild(card);

  // Reset modal
  document.getElementById('newName').value = '';
  document.getElementById('newPrice').value = '';
  document.getElementById('newFeatures').value = '';
  document.getElementById('imgPreview').innerHTML = `<div class="ph-add">📷</div><div class="ph-add-text">Tap to upload image</div>`;
  document.getElementById('imgFile').value = '';
  newImgDataUrl = null;

  closeAddModal();
}



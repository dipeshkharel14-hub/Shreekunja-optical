<!DOCTYPE html>
<html lang="ne">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Shreekunja Optical | श्रीकुञ्ज अप्टिकल</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@300;400;500;600;700&family=Bebas+Neue&family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,200;0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════════════════
   ROOT VARIABLES — OLED CYBER-MEDICAL PALETTE
══════════════════════════════════════════════════════ */
:root {
  --black:    #050505;
  --black2:   #0a0a0a;
  --black3:   #0f0f0f;
  --glass:    rgba(255,255,255,0.04);
  --glass2:   rgba(255,255,255,0.07);
  --border:   rgba(255,255,255,0.07);
  --border-em:rgba(46,224,113,0.25);
  --em:       #2ee071;
  --em2:      #1db855;
  --em-glow:  rgba(46,224,113,0.15);
  --em-deep:  rgba(46,224,113,0.06);
  --silver:   #c8d0d8;
  --silver2:  #e8edf2;
  --t1:       #f0f4f8;
  --t2:       #7a8694;
  --t3:       #3a4450;
  --r:        40px;
  --r2:       24px;
  --r3:       16px;
}

/* ══════════════════════════════════════════════════════
   RESET & BASE
══════════════════════════════════════════════════════ */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { font-size:16px; scroll-behavior:smooth; }

body {
  background: var(--black);
  color: var(--t1);
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
  min-height: 100vh;
  overflow-x: hidden;
  /* Mobile-first max width centered */
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* SCROLLBAR */
::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: var(--black); }
::-webkit-scrollbar-thumb { background: var(--em2); border-radius: 2px; }

/* ══════════════════════════════════════════════════════
   PHONE SHELL — centers and constrains mobile layout
══════════════════════════════════════════════════════ */
.phone {
  width: 100%;
  max-width: 420px;
  min-height: 100vh;
  background: var(--black);
  position: relative;
  overflow-x: hidden;
  overflow-y: auto;
  padding-bottom: 100px;
  /* ambient glow */
  box-shadow: 0 0 120px rgba(46,224,113,0.04), 0 0 280px rgba(46,224,113,0.02);
}

/* Desktop frame hint */
@media (min-width:500px) {
  body { background: #020202; padding: 20px 0; align-items: center; min-height: 100vh; }
  .phone {
    border-radius: 44px;
    border: 1px solid rgba(255,255,255,0.06);
    max-height: 92vh;
    overflow-y: auto;
    box-shadow: 0 40px 120px rgba(0,0,0,0.9), 0 0 80px rgba(46,224,113,0.06), inset 0 1px 0 rgba(255,255,255,0.05);
  }
}

/* ══════════════════════════════════════════════════════
   NOISE TEXTURE OVERLAY
══════════════════════════════════════════════════════ */
.phone::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
  max-width: 420px;
}

/* ══════════════════════════════════════════════════════
   STICKY GLASSMORPHISM HEADER
══════════════════════════════════════════════════════ */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 22px;
  background: rgba(5,5,5,0.75);
  backdrop-filter: blur(24px) saturate(1.4);
  -webkit-backdrop-filter: blur(24px) saturate(1.4);
  border-bottom: 1px solid var(--border);
}
.header::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--em), transparent);
  opacity: 0.3;
}

.logo-block { display: flex; flex-direction: column; gap: 1px; }
.logo-en {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 15px;
  letter-spacing: 3px;
  text-transform: uppercase;
  background: linear-gradient(135deg, var(--silver2), var(--silver), #a0a8b0);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}
.logo-ne {
  font-family: 'Noto Sans Devanagari', sans-serif;
  font-weight: 400;
  font-size: 11px;
  color: var(--em);
  letter-spacing: 0.5px;
  line-height: 1;
}
.header-actions { display: flex; align-items: center; gap: 10px; }
.hdr-btn {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: var(--glass2);
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.3s;
}
.hdr-btn:hover { background: var(--em-glow); border-color: var(--border-em); }

/* ══════════════════════════════════════════════════════
   HERO SECTION
══════════════════════════════════════════════════════ */
.hero {
  position: relative;
  padding: 48px 24px 40px;
  overflow: hidden;
  text-align: center;
}
/* Ambient orb */
.hero::before {
  content: '';
  position: absolute;
  top: -60px; left: 50%; transform: translateX(-50%);
  width: 320px; height: 320px;
  background: radial-gradient(circle, rgba(46,224,113,0.09) 0%, transparent 65%);
  pointer-events: none;
  animation: pulse-orb 4s ease-in-out infinite;
}
@keyframes pulse-orb {
  0%,100% { opacity: 0.6; transform: translateX(-50%) scale(1); }
  50% { opacity: 1; transform: translateX(-50%) scale(1.08); }
}

/* Status pill */
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 14px;
  border-radius: 20px;
  background: var(--em-deep);
  border: 1px solid var(--border-em);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--em);
  margin-bottom: 24px;
  animation: fadeIn 0.8s ease both;
}
.status-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--em);
  animation: blink 2s ease-in-out infinite;
}
@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

.hero-en {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(54px, 15vw, 72px);
  line-height: 0.92;
  letter-spacing: 4px;
  background: linear-gradient(180deg, var(--t1) 0%, rgba(200,208,216,0.7) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: slideUp 0.9s 0.1s ease both;
}
.hero-ne {
  font-family: 'Noto Sans Devanagari', sans-serif;
  font-weight: 300;
  font-size: 16px;
  color: var(--em);
  letter-spacing: 1px;
  margin-top: 10px;
  opacity: 0.85;
  animation: slideUp 0.9s 0.2s ease both;
}
.hero-sub {
  font-size: 12px;
  color: var(--t2);
  margin-top: 16px;
  letter-spacing: 1px;
  line-height: 1.7;
  max-width: 280px;
  margin-left: auto;
  margin-right: auto;
  animation: slideUp 0.9s 0.3s ease both;
}

/* Eye scan graphic */
.eye-scan {
  width: 120px; height: 60px;
  margin: 28px auto 0;
  position: relative;
  animation: slideUp 0.9s 0.4s ease both;
}
.eye-scan svg { width: 100%; height: 100%; }

@keyframes slideUp {
  from { opacity:0; transform:translateY(24px); }
  to   { opacity:1; transform:translateY(0); }
}
@keyframes fadeIn {
  from { opacity:0; } to { opacity:1; }
}

/* ══════════════════════════════════════════════════════
   SECTION LABEL
══════════════════════════════════════════════════════ */
.sec-label {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 24px;
  margin-bottom: 14px;
}
.sec-label-line { flex:1; height:1px; background: linear-gradient(90deg, var(--border), transparent); }
.sec-label-text {
  font-size: 9px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--t3);
  font-weight: 500;
  white-space: nowrap;
}

/* ══════════════════════════════════════════════════════
   LENS SIMULATOR
══════════════════════════════════════════════════════ */
.sim-section { padding: 0 20px 36px; }
.sim-card {
  border-radius: var(--r);
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--black2);
  position: relative;
  box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.02);
}
.sim-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent 10%, var(--em) 50%, transparent 90%);
  opacity: 0.4;
  z-index: 5;
}

.sim-labels {
  display: flex;
  justify-content: space-between;
  padding: 16px 20px 10px;
  position: relative;
  z-index: 4;
}
.sim-lbl {
  font-family: 'Noto Sans Devanagari', sans-serif;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.sim-lbl-ne { font-size: 11px; font-weight: 500; color: var(--t2); }
.sim-lbl-en { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; }
.sim-lbl.bad .sim-lbl-ne { color: #ff6b6b; }
.sim-lbl.bad .sim-lbl-en { color: rgba(255,107,107,0.6); }
.sim-lbl.good .sim-lbl-ne { color: var(--em); }
.sim-lbl.good .sim-lbl-en { color: rgba(46,224,113,0.6); }

/* Canvas viewer */
.sim-viewer {
  position: relative;
  height: 220px;
  cursor: ew-resize;
  overflow: hidden;
  user-select: none;
}
#cvA, #cvB { position: absolute; inset:0; width:100%; height:100%; }
#cvA { z-index:1; }
#cvB { z-index:2; }

/* Slider */
.sim-slider-line {
  position: absolute;
  top: 0; bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, transparent, var(--em) 20%, var(--em) 80%, transparent);
  z-index: 10;
  transform: translateX(-50%);
  pointer-events: none;
}
.sim-slider-knob {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 38px; height: 38px;
  border-radius: 50%;
  background: rgba(5,5,5,0.9);
  border: 2px solid var(--em);
  box-shadow: 0 0 20px rgba(46,224,113,0.5), 0 0 40px rgba(46,224,113,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; color: var(--em);
  z-index: 11;
  pointer-events: none;
  animation: knob-pulse 3s ease-in-out infinite;
}
@keyframes knob-pulse {
  0%,100% { box-shadow: 0 0 16px rgba(46,224,113,0.45), 0 0 32px rgba(46,224,113,0.15); }
  50%      { box-shadow: 0 0 28px rgba(46,224,113,0.7), 0 0 56px rgba(46,224,113,0.3); }
}

/* Sim mode tabs */
.sim-modes {
  display: flex;
  gap: 6px;
  padding: 12px 16px 16px;
  overflow-x: auto;
  scrollbar-width: none;
}
.sim-modes::-webkit-scrollbar { display: none; }
.sim-mode {
  flex-shrink: 0;
  padding: 6px 14px;
  border-radius: 20px;
  border: 1px solid var(--border);
  background: transparent;
  font-family: 'Noto Sans Devanagari', sans-serif;
  font-size: 11px;
  color: var(--t2);
  cursor: pointer;
  transition: all 0.25s;
  white-space: nowrap;
}
.sim-mode.on {
  background: var(--em-deep);
  border-color: var(--border-em);
  color: var(--em);
  box-shadow: 0 0 12px rgba(46,224,113,0.1);
}

/* ══════════════════════════════════════════════════════
   GLASS FEATURE CARDS
══════════════════════════════════════════════════════ */
.cards-section { padding: 0 20px 32px; }
.cards-grid { display: flex; flex-direction: column; gap: 12px; }

.feat-card {
  border-radius: var(--r2);
  border: 1px solid var(--border);
  background: var(--glass);
  backdrop-filter: blur(16px);
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  cursor: pointer;
  transition: all 0.35s;
  position: relative;
  overflow: hidden;
}
.feat-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, transparent 60%);
  border-radius: inherit;
  pointer-events: none;
}
.feat-card:hover {
  border-color: var(--border-em);
  background: var(--em-deep);
  transform: translateY(-2px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 0 20px rgba(46,224,113,0.08);
}
.feat-card:active { transform: scale(0.98); }

.feat-icon-wrap {
  width: 56px; height: 56px;
  border-radius: 18px;
  background: var(--glass2);
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 26px;
  flex-shrink: 0;
  position: relative;
  transition: all 0.3s;
}
.feat-card:hover .feat-icon-wrap {
  background: var(--em-deep);
  border-color: var(--border-em);
  box-shadow: 0 0 20px rgba(46,224,113,0.15);
}

.feat-text { flex: 1; }
.feat-ne {
  font-family: 'Noto Sans Devanagari', sans-serif;
  font-weight: 500;
  font-size: 15px;
  color: var(--t1);
  line-height: 1.2;
}
.feat-en {
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--t2);
  margin-top: 3px;
}
.feat-tag {
  font-size: 9px;
  padding: 3px 8px;
  border-radius: 8px;
  background: var(--em-deep);
  border: 1px solid var(--border-em);
  color: var(--em);
  letter-spacing: 1px;
  margin-top: 6px;
  display: inline-block;
}
.feat-arrow {
  color: var(--t3);
  font-size: 18px;
  transition: all 0.3s;
  flex-shrink: 0;
}
.feat-card:hover .feat-arrow { color: var(--em); transform: translateX(4px); }

/* ══════════════════════════════════════════════════════
   STATS ROW
══════════════════════════════════════════════════════ */
.stats-section { padding: 0 20px 32px; }
.stats-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
}
.stat-card {
  border-radius: var(--r2);
  border: 1px solid var(--border);
  background: var(--glass);
  padding: 16px 12px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.stat-card::before {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--em), transparent);
  opacity: 0.4;
}
.stat-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 32px;
  color: var(--em);
  line-height: 1;
  letter-spacing: 1px;
}
.stat-lbl-en { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--t2); margin-top: 3px; }
.stat-lbl-ne { font-family: 'Noto Sans Devanagari', sans-serif; font-size: 10px; color: var(--t3); margin-top: 2px; }

/* ══════════════════════════════════════════════════════
   INFO SECTION
══════════════════════════════════════════════════════ */
.info-section { padding: 0 20px 32px; }
.info-card {
  border-radius: var(--r);
  border: 1px solid var(--border);
  background: var(--glass);
  overflow: hidden;
}
.info-card-top {
  padding: 22px;
  border-bottom: 1px solid var(--border);
}
.info-brand-ne {
  font-family: 'Noto Sans Devanagari', sans-serif;
  font-weight: 600;
  font-size: 16px;
  color: var(--t1);
}
.info-brand-tag {
  font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
  color: var(--em); margin-top: 2px;
}

.info-rows { padding: 6px 0; }
.info-row {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 14px 22px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  cursor: pointer;
  transition: background 0.25s;
}
.info-row:last-child { border-bottom: none; }
.info-row:hover { background: rgba(46,224,113,0.03); }
.info-icon {
  width: 34px; height: 34px;
  border-radius: 12px;
  background: var(--glass2);
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 15px;
  flex-shrink: 0;
}
.info-content { flex: 1; }
.info-label { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--t3); margin-bottom: 3px; }
.info-val { font-size: 13px; color: var(--t1); line-height: 1.5; }
.info-val a { color: var(--em); text-decoration: none; }
.info-val-ne { font-family: 'Noto Sans Devanagari', sans-serif; font-size: 11px; color: var(--t2); margin-top: 1px; }
.info-chevron { color: var(--t3); font-size: 14px; align-self: center; }

/* MAP LINK ROW */
.map-row {
  display: flex; align-items: center; gap: 14px;
  padding: 14px 22px;
  text-decoration: none;
  transition: background 0.25s;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.map-row:hover { background: rgba(46,224,113,0.04); }
.map-badge {
  flex:1;
  display: flex; align-items: center; gap: 8px;
}
.map-badge-text { font-size: 13px; color: var(--em); }
.map-badge-ne { font-family: 'Noto Sans Devanagari', sans-serif; font-size: 10px; color: var(--t2); }

/* ══════════════════════════════════════════════════════
   CTA BUTTON
══════════════════════════════════════════════════════ */
.cta-section { padding: 0 20px 20px; }
.cta-btn {
  width: 100%;
  padding: 18px 24px;
  border-radius: var(--r2);
  background: linear-gradient(135deg, var(--em2) 0%, #16a348 50%, var(--em2) 100%);
  background-size: 200% 200%;
  border: none;
  color: #050505;
  font-family: 'Noto Sans Devanagari', sans-serif;
  font-weight: 700;
  font-size: 15px;
  cursor: pointer;
  transition: all 0.35s;
  letter-spacing: 0.5px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(46,224,113,0.3), 0 0 0 1px rgba(46,224,113,0.2);
  animation: btn-grad 4s linear infinite;
}
@keyframes btn-grad { 0%{background-position:0% 50%;} 50%{background-position:100% 50%;} 100%{background-position:0% 50%;} }
.cta-btn::before {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);
  border-radius: inherit;
}
.cta-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 48px rgba(46,224,113,0.4), 0 0 0 1px rgba(46,224,113,0.3);
}
.cta-btn:active { transform: scale(0.97); }
.cta-en {
  font-family: 'DM Sans', sans-serif;
  font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
  opacity: 0.7; display: block; margin-top: 2px;
}

/* ══════════════════════════════════════════════════════
   BOTTOM NAV DOCK
══════════════════════════════════════════════════════ */
.bottom-nav {
  position: sticky;
  bottom: 0;
  z-index: 200;
  padding: 0 24px 20px;
  background: linear-gradient(0deg, rgba(5,5,5,0.98) 0%, rgba(5,5,5,0.7) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
.nav-dock {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(15,15,15,0.9);
  border: 1px solid var(--border);
  border-radius: 28px;
  padding: 12px 8px;
  position: relative;
  box-shadow: 0 -4px 40px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.02);
}
/* green underglow */
.nav-dock::before {
  content: '';
  position: absolute;
  bottom: -8px; left: 20%; right: 20%; height: 8px;
  background: radial-gradient(ellipse, rgba(46,224,113,0.25) 0%, transparent 70%);
  filter: blur(6px);
}
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 6px 16px;
  border-radius: 18px;
  cursor: pointer;
  transition: all 0.3s;
  position: relative;
}
.nav-item.active { background: var(--em-deep); }
.nav-item.active .nav-icon { color: var(--em); }
.nav-item.active .nav-ne { color: var(--em); }
.nav-icon { font-size: 20px; color: var(--t3); transition: all 0.3s; }
.nav-ne {
  font-family: 'Noto Sans Devanagari', sans-serif;
  font-size: 9px;
  color: var(--t3);
  transition: all 0.3s;
}
/* Active indicator dot */
.nav-item.active::after {

//  CUSTOMER NOTIFICATION HUB
// ═══════════════════════════════════════
function sendPickupNotification() {
  const input = document.getElementById('notifyPhone');
  const statusEl = document.getElementById('notifyStatus');
  const statusText = document.getElementById('notifyStatusText');

  // Sanitize: remove spaces, dashes, parentheses
  let phone = input.value.replace(/[\s\-\(\)]/g, '').trim();

  if (!phone) {
    input.focus();
    input.style.borderColor = '#ff6b6b';
    input.style.boxShadow = '0 0 0 3px rgba(255,107,107,0.15)';
    statusEl.classList.add('show');
    statusEl.style.background = 'rgba(255,107,107,0.08)';
    statusEl.style.borderColor = 'rgba(255,107,107,0.3)';
    statusEl.style.color = '#ff6b6b';
    statusText.textContent = '⚠️ Please enter a phone number first.';
    setTimeout(() => {
      statusEl.classList.remove('show');
      input.style.borderColor = '';
      input.style.boxShadow = '';
      statusEl.style.background = '';
      statusEl.style.borderColor = '';
      statusEl.style.color = '';
    }, 3000);
    return;
  }

  // Prepend Nepal country code if not already present
  if (phone.startsWith('00977')) {
    phone = phone.slice(2); // strip leading 00
  } else if (phone.startsWith('+977')) {
    phone = phone.slice(1); // strip +
  } else if (!phone.startsWith('977')) {
    phone = '977' + phone;
  }

  const message = encodeURIComponent(
    'Dear Customer,\n\nWe are pleased to inform you that your eyeglasses are ready for pickup.\n\nKindly visit us at your convenience:\n📍 Shreekunja Optical, BP Eye Hospital, Kathmandu\n📞 984-1623999\n\nThank you for choosing Shreekunja Optical. We look forward to seeing you soon.'
  );

  const whatsappUrl = `https://wa.me/${phone}?text=${message}`;

  // Show status
  statusEl.style.background = '';
  statusEl.style.borderColor = '';
  statusEl.style.color = '';
  statusEl.classList.add('show');
  statusText.textContent = 'Opening WhatsApp for ' + phone.replace('977', '+977-') + '…';

  window.open(whatsappUrl, '_blank');

  // Reset after 4 seconds
  setTimeout(() => {
    statusEl.classList.remove('show');
    input.value = '';
  }, 4000);
}

// Allow pressing Enter in the phone input
document.getElementById('notifyPhone').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') sendPickupNotification();
});


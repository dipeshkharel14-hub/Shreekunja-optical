# ============================================================
# SHREEKUNJA OPTICAL 2.0 — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit ".env" to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
# Render/managed Postgres connection string, e.g.
# postgres://user:password@host:5432/shreekunja_optical
DATABASE_URL=
# Set to "true" only if your provider requires SSL (Render does)
DATABASE_SSL=true

# --- Auth / Sessions ---
# Long random strings. Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=
COOKIE_SECURE=true

# --- Shreekunja AI (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Object / Cloud Storage (product images, blog covers, prescriptions) ---
# STORAGE_PROVIDER: "s3" | "cloudinary" | "supabase" etc.
STORAGE_PROVIDER=
STORAGE_API_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=

# --- WhatsApp Notifications ---
# Leave blank to keep using the existing wa.me deep-link flow.
# Set only if/when migrating to the official WhatsApp Business API.
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- First-run Admin Seed (see seed/seed.js) ---
# Required only when running `npm run seed` for the first time.
# These are never stored in the database — only their bcrypt hashes are.
ADMIN_1_NAME="Dipesh Kharel"
ADMIN_1_ROLE=SUPER_ADMIN
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=

ADMIN_2_NAME="Durga Kharel"
ADMIN_2_ROLE=ADMIN
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

ADMIN_3_NAME="Devi Prasad Kharel"
ADMIN_3_ROLE=ADMIN
ADMIN_3_EMAIL=
ADMIN_3_PASSWORD=

# Set to "true" only when you explicitly intend to (re)seed admins.
# The seed script refuses to run without this, and refuses to create
# a 4th admin account under any circumstance.
ALLOW_ADMIN_SEED=false
